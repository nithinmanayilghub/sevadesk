# Copy to .env to override defaults. Local development values only, never real secrets.
# Postgres user name.
POSTGRES_USER=seva
# Postgres password (local only).
POSTGRES_PASSWORD=change-me-local-only
# Postgres database name.
POSTGRES_DB=seva
# Version string the API reports at /api/v1/hello.
# Baked in at build time: after changing it, run `docker compose up --build`.
APP_VERSION=dev
# Where the collector sends traces and logs. Empty = the local Grafana (http://localhost:3001).
# For Grafana Cloud: the OTLP endpoint, e.g. https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
OTLP_EXPORT_ENDPOINT=
# Auth header for that endpoint. Grafana Cloud: "Basic <base64 of instanceId:token>". Never commit it.
OTLP_EXPORT_AUTH=
