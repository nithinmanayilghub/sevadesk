# Copy to /opt/sevadesk/.env ON THE DEMO SERVER, fill in, then: chmod 600 .env
# Real values never go into git. IMAGE_TAG is not here: deploy.sh sets it.
# Public name of the demo: the VM IP with dashes + .sslip.io, e.g. 140-238-1-2.sslip.io
DEMO_DOMAIN=
# Neon DIRECT connection string (not the "-pooler" host), with the psycopg driver and TLS:
# postgresql+psycopg://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=
# Grafana Cloud OTLP endpoint, e.g. https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
OTLP_EXPORT_ENDPOINT=
# "Basic <base64 of instanceId:token>". Use a fresh token made for the demo.
OTLP_EXPORT_AUTH=
