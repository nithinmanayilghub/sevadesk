  "components": {
    "schemas": {
      "AcceptInviteRequest": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 64,
            "title": "Token"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "title": "AcceptInviteRequest"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "description": "The error response shape, for the OpenAPI schema (so the frontend types know it)."
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "redis": {
            "type": "string",
            "title": "Redis"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "redis",
          "version"
        ],
        "title": "HealthResponse"
      },
      "HelloResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "message",
          "version"
        ],
        "title": "HelloResponse"
      },
      "InviteCreated": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "token",
          "expires_at"
        ],
        "title": "InviteCreated",
        "description": "The raw token, shown ONCE. The database keeps only its hash."
      },
      "InvitePreview": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "InvitePreview"
      },
      "InviteRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "type": "array",
            "title": "Roles"
          }
        },
        "type": "object",
        "required": [
          "email",
          "roles"
        ],
        "title": "InviteRequest"
      },
      "InviteTokenRequest": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 64,
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "InviteTokenRequest"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MeResponse": {
        "properties": {
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "type": "array",
            "title": "Roles"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "type": "array",
            "title": "Permissions"
          },
          "theme": {
            "$ref": "#/components/schemas/Theme"
          }
        },
        "type": "object",
        "required": [
          "roles",
          "permissions",
          "theme"
        ],
        "title": "MeResponse",
        "description": "What the app needs to know about the logged-in User: their Roles, and what they may do.\n\nThe app shows or hides nav items and pages from `permissions` (UX-DR27). It never\nworks the rules out itself: the FR-10 table lives only in the backend (AD-5)."
      },
      "MemberUpdate": {
        "properties": {
          "roles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Role"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Roles"
          },
          "is_active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Active"
          }
        },
        "type": "object",
        "title": "MemberUpdate",
        "description": "A change to one member. Leave a field out (or null) to keep it as it is."
      },
      "Permission": {
        "type": "string",
        "enum": [
          "manage_setup",
          "use_inbox_and_bookings",
          "see_own_bookings",
          "see_dashboard"
        ],
        "title": "Permission",
        "description": "One member per row of the FR-10 table. permissions.py says which Roles may do each.\n\nA later action with no FR-10 row (e.g. delete a Customer) adds its own member."
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "staff",
          "technician"
        ],
        "title": "Role"
      },
      "SignupRequest": {
        "properties": {
          "business_name": {
            "type": "string",
            "title": "Business Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "business_name",
          "email",
          "password"
        ],
        "title": "SignupRequest"
      },
      "SignupResponse": {
        "properties": {
          "business_id": {
            "type": "string",
            "format": "uuid",
            "title": "Business Id"
          },
          "business_name": {
            "type": "string",
            "title": "Business Name"
          }
        },
        "type": "object",
        "required": [
          "business_id",
          "business_name"
        ],
        "title": "SignupResponse"
      },
      "TeamMember": {
        "properties": {
          "membership_id": {
            "type": "string",
            "format": "uuid",
            "title": "Membership Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "type": "array",
